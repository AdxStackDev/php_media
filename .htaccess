# IPTV Player - Simplified Apache Configuration
# This version avoids common configuration issues

# Set default charset
AddDefaultCharset UTF-8

# Security Headers (only if mod_headers is available)
<IfModule mod_headers.c>
    # Prevent clickjacking
    Header set X-Frame-Options "SAMEORIGIN"
    
    # XSS Protection
    Header set X-XSS-Protection "1; mode=block"
    
    # Prevent MIME type sniffing
    Header set X-Content-Type-Options "nosniff"
</IfModule>

# Enable compression (only if mod_deflate is available)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Browser caching (only if mod_expires is available)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>

# Protect sensitive files
<FilesMatch "\.(md|log|ini|conf)$">
    Require all denied
</FilesMatch>

# Optional: Enable mod_rewrite for clean URLs
<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Redirect to login if accessing root
    RewriteRule ^$ login.php [L]
</IfModule>
